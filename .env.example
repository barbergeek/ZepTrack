# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_PATH=./data/zeptrack.db

# Frontend Configuration
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_APP_VERSION=2.0.3

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CORS Configuration (comma-separated origins for production)
CORS_ORIGINS=https://your-domain.com

# Session Cookie Configuration
SESSION_COOKIE_NAME=zeptrack_session

# Email Configuration (for MFA codes and invites)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@example.com

# Application URL (for invite links)
APP_URL=http://localhost:3000
